# ==============================================================================
# CademyX — Resend Email Integration Configuration
# ==============================================================================
# 1. Sign up / log in to https://resend.com
# 2. Generate an API Key under "API Keys" (starts with 're_')
# 3. Paste your key below:
RESEND_API_KEY=re_your_api_key_here

# Admin notification destination (all form submissions will be delivered here):
CONTACT_NOTIFICATION_EMAIL=cademyxedu@gmail.com

# Sending email address:
# - For sandbox testing: onboarding@resend.dev
# - For production: admissions@yourdomain.com (must be a domain verified in Resend)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ==============================================================================
# Website & Advisory Configuration
# ==============================================================================
NEXT_PUBLIC_SITE_URL=https://cademyx.org
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/cademyxedu/30min
NEXT_PUBLIC_WHATSAPP_NUMBER=918375897148
NEXT_PUBLIC_CONTACT_PHONE=+91 8375897148
